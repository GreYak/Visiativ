@page "/basket"
@rendermode InteractiveServer

@inject IVisiativApiClient Api

<PageTitle>Votre panier</PageTitle>

<h1>Votre panier</h1>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (items == null)
{
    <p><em>Chargement de votre panier...</em></p>
}
else if (items.Length == 0)
{
    <p>Votre panier est vide.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Quantité</th>
                <th>Article</th>
                <th>Prix (€)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.Quantity</td>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-outline-danger" @onclick="ClearBasket" disabled="@isProcessing">
            Vider le panier
        </button>
        <button class="btn btn-success" @onclick="Checkout" disabled="@isProcessing">
            Payer
        </button>
    </div>
}

@code {
    private BasketItemResponse[]? items;
    private string? errorMessage;
    private bool isProcessing;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadBasket();
        StateHasChanged();
    }

    private async Task LoadBasket()
    {
        try
        {
            items = await Api.GetBasketAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Impossible de charger le panier : {ex.Message}";
            items = [];
        }
    }

    private async Task ClearBasket()
    {
        errorMessage = null;
        isProcessing = true;
        var response = await Api.ClearBasketAsync();
        if (response.IsSuccessStatusCode)
            items = [];
        else
            errorMessage = "Impossible de vider le panier.";
        isProcessing = false;
    }

    private async Task Checkout()
    {
        errorMessage = null;
        isProcessing = true;
        var response = await Api.ClearBasketAsync();
        if (response.IsSuccessStatusCode)
            items = [];
        else
            errorMessage = "Erreur lors du paiement.";
        isProcessing = false;
    }
}
