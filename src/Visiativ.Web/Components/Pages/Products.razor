@page "/products"
@rendermode InteractiveServer

@inject IVisiativApiClient Api

<PageTitle>Catalogue produits</PageTitle>

<h1>Catalogue produits</h1>

@if (successMessage is not null)
{
    <div class="alert alert-success alert-dismissible">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}
@if (errorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (products == null)
{
    <p><em>Chargement...</em></p>
}
else if (products.Length == 0)
{
    <p>Aucun produit disponible.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Prix (€)</th>
                <th>Stock</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                var qty = quantities[product.Id];
                var stock = stocks[product.Id];

                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price.ToString("F2")</td>
                    <td>
                        @if (stock == 0)
                        {
                            <span class="badge bg-danger">Rupture</span>
                        }
                        else
                        {
                            @stock
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => Increment(product.Id)"
                                disabled="@(stock == 0)">
                            <span class="bi bi-plus-square-fill"></span>
                        </button>
                    </td>
                    <td>
                        @if (qty > 0)
                        {
                            <button class="btn btn-sm btn-success"
                                    @onclick="() => AddToBasket(product.Id, qty)">
                                Add @qty
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private ProductResponse[]? products;
    private Dictionary<Guid, int> stocks = [];
    private Dictionary<Guid, int> quantities = [];
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        products   = await Api.GetProductsAsync();
        stocks     = products.ToDictionary(p => p.Id, p => p.Stock);
        quantities = products.ToDictionary(p => p.Id, _ => 0);
        StateHasChanged();
    }

    private void Increment(Guid productId)
    {
        if (stocks[productId] <= 0) return;
        stocks[productId]--;
        quantities[productId]++;
    }

    private async Task AddToBasket(Guid productId, int qty)
    {
        successMessage = null;
        errorMessage   = null;
        try
        {
            var response = await Api.AddItemAsync(productId, qty);
            if (response.IsSuccessStatusCode)
            {
                quantities[productId] = 0;
                successMessage = $"✓ Ajouté au panier ({qty} article{(qty > 1 ? "s" : "")})";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = "Dépassement du stock : la quantité totale dans le panier dépasserait le stock disponible.";
                stocks[productId]    += qty;
                quantities[productId] = 0;
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Erreur {(int)response.StatusCode} — {body}";
                stocks[productId]    += qty;
                quantities[productId] = 0;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur réseau — {ex.Message}";
            stocks[productId]    += qty;
            quantities[productId] = 0;
        }
    }
}
